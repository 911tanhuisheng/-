# 本地私密配置模板（不要提交仓库）
# 使用：复制为 application-local.yml（同目录），填入真实值后重启主服务
# application.yml 已通过 spring.config.import 自动加载该文件（若存在）

spring:
  datasource:
    password: your_mysql_password

  data:
    redis:
      host: localhost

  mail:
    username: your_email@example.com
    password: your_mail_app_password

jwt:
  secret: "replace-with-random-string-at-least-32-characters-long"

minio:
  endpoint: http://127.0.0.1:9000
  access-key: minioadmin
  secret-key: minioadmin
  bucket-name: mayue-oj
  public-url:

codesandbox:
  type: remote
  url: http://127.0.0.1:8080/api/sandbox
  auth-key: 123456

bailian:
  enabled: true
  api-key: your_dashscope_api_key

# 判题走 RabbitMQ 时（同时删掉 application.yml 里 RabbitAutoConfiguration 的 exclude）：
# judge:
#   mq:
#     mode: rabbitmq
# spring:
#   rabbitmq:
#     host: localhost
#     port: 5672
#     username: guest
#     password: guest
